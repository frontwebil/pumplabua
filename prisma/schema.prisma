generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  surname      String
  middleName   String?
  email        String    @unique
  dateBirthday DateTime?
  phoneNumber  String?
  password     String
  createdAt    DateTime  @default(now())

  resetToken       String?
  resetTokenExpiry DateTime?

  favoriteProducts String[] 
}

model Product {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  description  String?
  features     String?
  purpose      String?
  components   String?
  additional   String?
  category     String?
  images       String[]
  isBestseller Boolean  @default(false)
  isActive     Boolean  @default(true)

  variants Variant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Variant {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  flavor   String? // може бути null якщо таблетки без смаку
  amount   Float // кількість (напр. 500 або 60)
  unitType String // одиниця виміру: "g", "pcs", "caps", "ml"
  price    Float
  inStock  Boolean @default(true)
  discount Float?  @default(0)

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String  @db.ObjectId
}
